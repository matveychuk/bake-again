{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Bake Again Design System",
    "version": "1.0.0",
    "direction": "Warm Precision / Review applied",
    "status": "approved-foundation"
  },
  "color": {
    "$type": "color",
    "primitive": {
      "cream": { "$value": "#FAF6EF" },
      "warmWhite": { "$value": "#FFFDF9" },
      "linen": { "$value": "#EEE7DD" },
      "paleLinen": { "$value": "#F3EDE5" },
      "chocolate": { "$value": "#392721" },
      "cocoa": { "$value": "#735D54" },
      "terracotta": { "$value": "#A64F36" },
      "deepTerracotta": { "$value": "#853C29" },
      "slate": { "$value": "#52616B" },
      "ochre": { "$value": "#805C26" }
    },
    "semantic": {
      "background": {
        "page": { "$value": "{color.primitive.cream}" },
        "surface": { "$value": "{color.primitive.warmWhite}" },
        "panel": { "$value": "{color.primitive.linen}" },
        "panelSubtle": { "$value": "{color.primitive.paleLinen}" }
      },
      "text": {
        "primary": { "$value": "{color.primitive.chocolate}" },
        "secondary": { "$value": "{color.primitive.cocoa}" },
        "onAccent": { "$value": "{color.primitive.warmWhite}" }
      },
      "action": {
        "primary": { "$value": "{color.primitive.terracotta}" },
        "primaryStrong": { "$value": "{color.primitive.deepTerracotta}" }
      },
      "status": {
        "tested": {
          "text": { "$value": "{color.primitive.deepTerracotta}" },
          "background": { "$value": "#F4E6DF" }
        },
        "calculated": {
          "text": { "$value": "{color.primitive.slate}" },
          "background": { "$value": "#EDF0F2" }
        },
        "suggested": {
          "text": { "$value": "{color.primitive.ochre}" },
          "background": { "$value": "#F6EEDD" }
        }
      }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Newsreader", "Georgia", "serif"] },
      "body": { "$type": "fontFamily", "$value": ["Manrope", "Arial", "sans-serif"] }
    },
    "size": {
      "$type": "dimension",
      "label": { "$value": { "value": 12, "unit": "px" } },
      "bodySmall": { "$value": { "value": 14, "unit": "px" } },
      "body": { "$value": { "value": 16, "unit": "px" } },
      "bodyLarge": { "$value": { "value": 18, "unit": "px" } }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } },
    "24": { "$value": { "value": 96, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 4, "unit": "px" } },
    "round": { "$value": { "value": 999, "unit": "px" } }
  },
  "breakpoint": {
    "$type": "dimension",
    "mobile": { "$value": { "value": 620, "unit": "px" } },
    "tablet": { "$value": { "value": 900, "unit": "px" } },
    "compactDesktop": { "$value": { "value": 1120, "unit": "px" } }
  }
}
