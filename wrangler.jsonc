// Cloudflare Workers config for bakeagain.com (own Cloudflare account).
// Non-secret settings only. Secrets (OPENAI_API_KEY, ASSISTANT_SESSION_SECRET,
// TURNSTILE_SECRET_KEY) are set in the Cloudflare dashboard, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bake-again",
  "account_id": "a30f72a0516ba67edcf1e6a5c89a37b6",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS" },
  "observability": { "enabled": true },
  "d1_databases": [
