{
  "name": "bake-again",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run media:prepare",
    "dev": "vinext dev",
    "prebuild": "npm run media:prepare && npm run lead-magnets:prepare",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit --incremental false",
    "test:foundation": "node --experimental-strip-types --experimental-specifier-resolution=node --test lib/i18n/*.test.ts lib/persistence/*.test.ts content/recipes/*.test.ts",
    "test:personal": "node --experimental-strip-types --test lib/personal/*.test.ts lib/personal/server/*.test.ts",
    "test:personal:d1": "node scripts/check-personal-d1.mjs",
    "test:seo": "node --experimental-strip-types --test lib/seo/*.test.ts",
    "test:assistant": "node --experimental-strip-types --experimental-specifier-resolution=node --test lib/assistant/*.test.ts lib/assistant/server/*.test.ts app/api/assistant/*.test.ts app/api/assistant/actions/review/*.test.ts components/assistant/*.test.ts",
    "eval:assistant": "node --experimental-strip-types --experimental-specifier-resolution=node --test evals/*.test.ts",
    "smoke:site": "node scripts/smoke-site.mjs",
    "validate:recipes": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/validate-recipes.ts",
    "test:analytics": "node --experimental-strip-types --test lib/analytics/*.test.ts",
    "test:newsletter": "node --experimental-strip-types --test lib/newsletter/*.test.ts",
    "test:recipe-utilities": "node scripts/check-recipe-utilities.mjs",
    "media:prepare": "node scripts/prepare-media.mjs",
    "test:release-render": "node scripts/check-release-render.mjs",
    "db:generate": "drizzle-kit generate",
    "newsletter:prepare": "node --experimental-strip-types scripts/prepare-newsletter-templates.mjs",
    "lead-magnets:prepare": "node --experimental-strip-types scripts/prepare-lead-magnets.mjs && node --experimental-strip-types scripts/prepare-magnet-emails.mjs",
    "media:audit": "node scripts/prepare-media.mjs --audit",
    "test:commerce": "node --experimental-strip-types --test content/commerce/*.test.ts",
    "test:seo-render": "node scripts/check-seo-render.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "openai": "7.13.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "0.5.8",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
