# Server-only secret. Leave empty in source control.
OPENAI_API_KEY=
# Non-secret assistant runtime configuration.
OPENAI_MODEL=gpt-5.4-mini
ASSISTANT_ENABLED=false
ASSISTANT_MAX_OUTPUT_TOKENS=2000

# Conservative reserved spend: rolling 24 hours / UTC calendar month. Zero disables paid calls.
ASSISTANT_DAILY_BUDGET_USD=1
ASSISTANT_MONTHLY_BUDGET_USD=10

# Cloudflare D1 binding; Sites provisions it and applies drizzle/ migrations at publication.
ASSISTANT_QUOTA_BINDING=ASSISTANT_QUOTAS
# Exact production hostname, without protocol or path.
ASSISTANT_ALLOWED_HOSTNAME=
# Real Turnstile keys. The secret is server-only; official test keys are rejected.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only signing secret (minimum 32 characters when enabled). Leave empty in source control.
ASSISTANT_SESSION_SECRET=
