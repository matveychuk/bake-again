# Server-only secret. Leave empty in source control.
OPENAI_API_KEY=
# Non-secret assistant runtime configuration.
OPENAI_MODEL=gpt-5.4-mini
ASSISTANT_ENABLED=false
ASSISTANT_MAX_OUTPUT_TOKENS=2000

# Conservative reserved spend: rolling 24 hours / UTC calendar month. Zero disables paid calls.
ASSISTANT_DAILY_BUDGET_USD=1
ASSISTANT_MONTHLY_BUDGET_USD=10

# Cloudflare D1 binding; Sites provisions it and applies drizzle/ migrations at publication.
ASSISTANT_QUOTA_BINDING=ASSISTANT_QUOTAS
# Exact production hostname, without protocol or path.
ASSISTANT_ALLOWED_HOSTNAME=
# Real Turnstile keys. The secret is server-only; official test keys are rejected.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only signing secret (minimum 32 characters when enabled). Leave empty in source control.
ASSISTANT_SESSION_SECRET=

# Optional provider-hosted newsletter. Disabled until real confirmation and unsubscribe
# are verified with the chosen provider. No Bake Again email database or API key needed.
# Configure only languages with reviewed forms; no cross-language fallback.
NEWSLETTER_ENABLED=false
NEWSLETTER_PROVIDER_NAME=
NEWSLETTER_SIGNUP_URL_UK=
NEWSLETTER_SIGNUP_URL_EN=
NEWSLETTER_SIGNUP_URL_ES=

# Personal foundation. Runtime bindings only; missing config stays disabled.
# Supabase uses its publishable key + verified reader JWT + Postgres RLS.
# Never substitute a secret/service_role key. Phase C activation requires the separate migration and release gates.
PERSONAL_BACKEND=disabled
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Phase C: leave disabled until the separate Supabase sync migration and Auth/SMTP are verified.
PERSONAL_SYNC_ENABLED=false
PERSONAL_AUTH_READY=false

# Optional Google Search Console HTML verification value (server environment).
GOOGLE_SITE_VERIFICATION=
META_PIXEL_ID=
META_DOMAIN_VERIFICATION=

# Recipe reviews (Supabase community schema). All three plus SUPABASE_URL and
# Turnstile keys are required; otherwise the reviews section stays hidden.
# Server-only secrets: never the publishable key, never in the browser.
COMMUNITY_ENABLED=
COMMUNITY_SUPABASE_SECRET_KEY=
COMMUNITY_FINGERPRINT_SECRET=

# Site-hosted lessons. Keep disabled until migration, providers and phone purchase QA pass.
LESSONS_ENABLED=false
PAYHIP_API_KEY=
PAYHIP_WEBHOOK_PATH_SECRET=
PAYHIP_LESSON_PRODUCT_IDS=
SUPABASE_SERVICE_ROLE_KEY=
CF_STREAM_ACCOUNT_ID=
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_JWK=
# Local upload only; never required by the site runtime.
CLOUDFLARE_STREAM_API_TOKEN=
# Comma-separated extra exact hostnames used by Stream allowedOrigins in preview.
CF_STREAM_ALLOWED_ORIGINS=
BREVO_LESSON_BUYERS_LIST_ID=
BREVO_API_KEY=
# Must match the project's actual Supabase Auth email OTP expiry (in minutes).
LESSON_OTP_EXPIRY_MINUTES=
# Trusted scheduler POST /api/lessons/delivery, distinct random server secret.
LESSON_DELIVERY_JOB_SECRET=
